    {
      "type": "JavaScript",
      "name": "JavaScript",
      "nickname": "Shared Line Parameters",
      "command": "function formatEbsDate(value) {\n    if (!value) {\n        return \"\";\n    }\n\n    var parts = value.split(\"-\");\n    var months = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n                  \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\n\n    return parts[2] + \"-\" + months[Number(parts[1]) - 1] + \"-\" + parts[0];\n}\n\nfunction valueOrEmpty(value) {\n    return value === null || value === undefined ? \"\" : value;\n}\n\nvar receipt = receiptJson;\n\nvar currentReceiptId = receipt.RECEIPT_ID;\n\nvar expenseData = receipt.EXPENSE_DATA_JSON;\n\nif (typeof expenseData === \"string\") {\n    var expenseDataText = expenseData.trim();\n    if (expenseDataText === \"\") {\n        expenseData = null;\n    } else {\n        expenseData = JSON.parse(expenseDataText);\n    }\n}\n\nvar line =\n    expenseData &&\n    Array.isArray(expenseData.lines) &&\n    expenseData.lines.length > 0\n        ? expenseData.lines[0]\n        : {};\n\nvar expenseType = valueOrEmpty(receipt.EXPENSE_TYPE);\nvar totalAmount = valueOrEmpty(receipt.TOTAL_AMOUNT);\nvar receiptDate = valueOrEmpty(receipt.RECEIPT_DATE);\nvar merchant = valueOrEmpty(receipt.MERCHANT);\nvar location = valueOrEmpty(receipt.LOCATION);\nvar department = valueOrEmpty(receipt.DEPARTMENT);\n\nvar attachmentPath = \"\";\n// Expense location only: keep a nonblank analyzed location, otherwise use the\n// EBS default. This does not affect the credit transaction selection input.\nvar LocationName = String(location).trim() === \"\"\n    ? \"All Other Locations\"\n    : location;\nvar DetailReceiptMissing = valueOrEmpty(line.originalReceiptMissing);\nvar CompanyAttendees = valueOrEmpty(line.companyAttendees);\nvar ReceiptCurrencyChoice = valueOrEmpty(line.receiptCurrency);\nif (String(ReceiptCurrencyChoice).trim() === \"\") {\n    ReceiptCurrencyChoice = \"USD - US dollar\";\n}\nvar DetailReceiptAmount = totalAmount;\nvar StartDate = receiptDate;\nvar StartDateFormatted = formatEbsDate(receiptDate);\nvar Justification = String(valueOrEmpty(line.justification)).trim() === \"\"\n                     ? ReportPurpose\n                     : line.justification;\nvar ExchRate = valueOrEmpty(line.exchangeRate);\nvar DetailMerchantName = merchant;\nvar AirTravelType = valueOrEmpty(line.travelType);\nvar AirTicketClass = valueOrEmpty(line.ticketClass);\nvar AirFromLocation = valueOrEmpty(line.locationFrom);\nvar AirToLocation = valueOrEmpty(line.locationTo);\nvar NumberOfDays = valueOrEmpty(line.numberOfDays);\nvar AccEndDate = valueOrEmpty(line.endDate);\nvar AccEndDateFormatted = AccEndDate;\nvar MealAttendees = line.employees || [];\nvar MealGuests = line.guest || [];\nvar GuestEmployers = MealGuests.map(function (guest) {\n    return guest.employer == null ? \"\" : guest.employer;\n});\nvar MealNumberAttendees = MealAttendees.length + MealGuests.length;\n",
      "keepAlive": false,
      "throwError": false,
      "ignoreError": false,
      "isJavaScript": false,
      "isCustom": false,
