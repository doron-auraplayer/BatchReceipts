{
  "name": "ReceiptBatch_SetReceiptDetailsRPA",
  "description": "Shared native receipt-detail child for ReceiptBatch_CreateCashLinesRPA and ReceiptBatch_CreateCreditLinesRPA. Reuses the caller EBS session and returns the raw ReceiptBatch_SetLineDetails response.",
  "steps": [
    {
      "type": "JavaScript",
      "name": "JavaScript",
      "nickname": "Inputs",
      "command": "var RECEIPT_JSON = ServiceManager.getInput(\"RECEIPT_JSON\");\nvar REPORT_PURPOSE = ServiceManager.getInput(\"REPORT_PURPOSE\");\nvar LINE_INDEX = ServiceManager.getInput(\"LINE_INDEX\");\nvar RECEIPT_MODE = ServiceManager.getInput(\"RECEIPT_MODE\");\nServiceManager.sessionId = ServiceManager.getInput(\"sessionId\");\nServiceManager.keepAlive = true;\n\nvar ReportPurpose = REPORT_PURPOSE;\nvar detailLineIndex = LINE_INDEX;\nvar receiptMode = String(RECEIPT_MODE === null || RECEIPT_MODE === undefined ? \"\" : RECEIPT_MODE).trim().toUpperCase();\nif (receiptMode !== \"CASH\" && receiptMode !== \"CREDIT\") {\n    throw new Error(\"ReceiptBatch_SetReceiptDetailsRPA: unsupported RECEIPT_MODE '\" + String(RECEIPT_MODE) + \"'.\");\n}\nvar receiptJson = RECEIPT_JSON;\nif (typeof receiptJson === \"string\") {\n    try {\n        receiptJson = JSON.parse(receiptJson);\n    } catch (parseError) {\n        throw new Error(\n            \"BLOCKER ReceiptBatch_SetReceiptDetailsRPA step=Inputs reason=RECEIPT_JSON is not valid JSON.\"\n        );\n    }\n}\nif (receiptJson === null || receiptJson === undefined ||\n        Array.isArray(receiptJson) || typeof receiptJson !== \"object\") {\n    throw new Error(\n        \"BLOCKER ReceiptBatch_SetReceiptDetailsRPA step=Inputs reason=RECEIPT_JSON must be a JSON object or a JSON string containing an object.\"\n    );\n}\n",
      "keepAlive": false,
      "throwError": false,
      "ignoreError": false,
      "isJavaScript": false,
      "isCustom": false,
      "invalid": false,
      "inputs": [
        {
          "visible": true,
