      "type": "JavaScript",
      "name": "JavaScript",
      "nickname": "credit Set Line Details Guard",
      "command": "var creditSetLineResponse = ReceiptBatch_SetLineDetailsResponse;\nvar creditSetLineElements =\n    (creditSetLineResponse &&\n     creditSetLineResponse.Response &&\n     creditSetLineResponse.Response.ReceiptBatch_SetLineDetailsElements) || {};\n\nfunction creditFlagIsTrue(value) {\n    return value === true || String(value).toLowerCase() === \"true\";\n}\n\nif (creditFlagIsTrue(creditSetLineElements.CashLineErrorMessageExists)) {\n    throw new Error(\"credit Set Line Details: \" + String(creditSetLineElements.CashLineErrorMessage === null || creditSetLineElements.CashLineErrorMessage === undefined ? \"\" : creditSetLineElements.CashLineErrorMessage));\n}\nif (creditFlagIsTrue(creditSetLineElements.errorPopupExists)) {\n    throw new Error(\"credit Set Line Details: an error popup appeared.\");\n}\nvar creditSetLineError = creditSetLineElements.Error;\nif (creditSetLineError !== null && creditSetLineError !== undefined && String(creditSetLineError).trim() !== \"\") {\n    throw new Error(\"credit Set Line Details: \" + String(creditSetLineError));\n}\nvar creditSetLineTitle = String(creditSetLineElements.currentPageTitle === null || creditSetLineElements.currentPageTitle === undefined ? \"\" : creditSetLineElements.currentPageTitle);\nif (creditSetLineTitle.indexOf(\"Credit Card Expenses: Details\") === -1) {\n    throw new Error(\"credit Set Line Details: the page did not remain on Credit Card Expenses: Details, got '\" + creditSetLineTitle + \"'.\");\n}",
