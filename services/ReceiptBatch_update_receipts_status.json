{
  "name": "ReceiptBatch_update_receipts_status",
  "description": "Bulk-update STATUS for receipt IDs in RECEIPT_IDS_JSON belonging to EBS_USER. Optional EXPECTED_STATUS limits updates to rows still in that status; leave empty to update any current status. Example IDs: [12,18,25].",
  "formUrl": "${env.DB_CONNECTION_STR}",
  "command": "UPDATE XX_AP_BATCH_RECEIPTS\nSET STATUS = '${STATUS}'\nWHERE EBS_USER_NAME = UPPER(TRIM('${EBS_USER}'))\n  AND ('${EXPECTED_STATUS}' IS NULL OR STATUS = '${EXPECTED_STATUS}')\n  AND RECEIPT_ID IN (\n    SELECT ids.RECEIPT_ID\n    FROM JSON_TABLE(\n      '${RECEIPT_IDS_JSON}',\n      '$[*]' ERROR ON ERROR\n      COLUMNS (\n        RECEIPT_ID NUMBER PATH '$' ERROR ON ERROR\n      )\n    ) ids\n  )",
  "isEnabled": true,
