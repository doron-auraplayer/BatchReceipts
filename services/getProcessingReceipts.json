  "name": "getProcessingReceipts",
  "description": "",
  "formUrl": "${env.DB_CONNECTION_STR}",
  "command": "SELECT\r\n    RECEIPT_ID,\r\n    FILE_CONTENT\r\nFROM XX_AP_BATCH_RECEIPTS\r\nWHERE STATUS = 'PROCESSING'\r\n  AND (\r\n        '${EBS_USER}' IS NULL\r\n        OR TRIM('${EBS_USER}') = ''\r\n        OR EBS_USER_NAME = UPPER('${EBS_USER}')\r\n      )\r\nORDER BY RECEIPT_DATE DESC",
