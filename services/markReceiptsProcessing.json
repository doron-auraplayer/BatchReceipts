  "command": "UPDATE XX_AP_BATCH_RECEIPTS\nSET STATUS = 'PROCESSING'\nWHERE INSTR(\n          ',' || '${P_STATUSES}' || ',',\n          ',' || STATUS || ','\n      ) > 0\n  AND (\n        '${EBS_USER}' IS NULL\n        OR TRIM('${EBS_USER}') = ''\n        OR EBS_USER_NAME = UPPER('${EBS_USER}')\n      )",
