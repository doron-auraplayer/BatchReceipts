{
  "name": "ReceiptBatch_save_incomplete_credit_match",
  "description": "",
  "formUrl": "${env.DB_CONNECTION_STR}",
  "command": "UPDATE XX_AP_BATCH_RECEIPTS receipt\nSET STATUS = 'PROCESSED',\n    EXPENSE_TYPE = ${P_EXPENSE_TYPE:VARCHAR},\n    TOTAL_AMOUNT = ${P_TOTAL_AMOUNT:NUMERIC},\n    RECEIPT_DATE = TO_DATE(${P_RECEIPT_DATE:VARCHAR}, 'YYYY-MM-DD'),\n    MERCHANT = ${P_MERCHANT:VARCHAR},\n    LOCATION = ${P_LOCATION:VARCHAR},\n    DEPARTMENT = ${P_DEPARTMENT:VARCHAR},\n    EXPENSE_DATA_JSON = ${P_EXPENSE_DATA_JSON:CLOB},\n    EXPENSE_DATA_UPDATED_DATE = SYSTIMESTAMP,\n    CREDIT_TRANSACTION = ${P_CREDIT_TRANSACTION:VARCHAR}\nWHERE receipt.RECEIPT_ID = ${P_RECEIPT_ID:NUMERIC}\n  AND receipt.EBS_USER_NAME = UPPER(TRIM(${P_EBS_USER:VARCHAR}))\n  AND receipt.STATUS IN ('PROCESSED', 'DRAFT', 'READY')\n  AND receipt.REPORT_ID IS NULL\n  AND EXISTS (\n      SELECT 1\n      FROM AP_CREDIT_CARD_TRXNS_ALL trx\n      JOIN AP_CARDS_ALL card ON card.CARD_ID = trx.CARD_ID\n        AND card.CARD_PROGRAM_ID = trx.CARD_PROGRAM_ID\n        AND card.ORG_ID = trx.ORG_ID\n      JOIN FND_USER ebs_user ON ebs_user.EMPLOYEE_ID = card.EMPLOYEE_ID\n      WHERE ebs_user.USER_NAME = receipt.EBS_USER_NAME\n        AND trx.TRX_ID = TO_NUMBER(CASE\n            WHEN REGEXP_LIKE(${P_CREDIT_TRANSACTION:VARCHAR}, '^[0-9]+$')\n            THEN ${P_CREDIT_TRANSACTION:VARCHAR}\n        END)\n        AND trx.REPORT_HEADER_ID IS NULL\n  )\n  AND NOT EXISTS (\n      SELECT 1\n      FROM XX_AP_BATCH_RECEIPTS other\n      WHERE other.RECEIPT_ID <> receipt.RECEIPT_ID\n        AND other.EBS_USER_NAME = receipt.EBS_USER_NAME\n        AND other.CREDIT_TRANSACTION = ${P_CREDIT_TRANSACTION:VARCHAR}\n  )\n",
  "isEnabled": true,
