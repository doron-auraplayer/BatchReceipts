{
  "name": "ReceiptBatch_ReceiptCurrency",
  "description": "",
  "formUrl": "${env.DB_CONNECTION_STR}",
  "command": "SELECT c.currency_code || ' - ' || t.name AS \"Currency\",\n       c.currency_code AS \"CurrencyCode\",\n       t.name AS \"CurrencyName\"\nFROM fnd_currencies c\nINNER JOIN fnd_currencies_tl t ON t.currency_code = c.currency_code AND t.language = 'US'\nWHERE c.enabled_flag = 'Y'\n  AND c.currency_flag = 'Y'\n  AND SYSDATE >= NVL(c.start_date_active, SYSDATE)\n  AND SYSDATE <= NVL(c.end_date_active, SYSDATE)\nORDER BY c.currency_code\n",
