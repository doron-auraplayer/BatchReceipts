{
  "name": "ReceiptBatch_get_draft_report_lines",
  "description": "",
  "formUrl": "${env.DB_CONNECTION_STR}",
  "command": "SELECT\n    RECEIPT_ID AS ReceiptBatch_RECEIPT_ID,\n    TO_CHAR(\n        RECEIPT_DATE,\n        'DD-Mon-YYYY',\n        'NLS_DATE_LANGUAGE=English'\n    ) AS ReceiptBatch_RECEIPT_DATE,\n    TO_CHAR(RECEIPT_DATE, 'YYYY-MM-DD')\n        AS ReceiptBatch_RECEIPT_DATE_ISO,\n    STATUS AS ReceiptBatch_STATUS,\n    EBS_USER_NAME AS ReceiptBatch_EBS_USER_NAME,\n    FILE_NAME AS ReceiptBatch_FILE_NAME,\n    FILE_TYPE AS ReceiptBatch_FILE_TYPE,\n    EXPENSE_TYPE AS ReceiptBatch_EXPENSE_TYPE,\n    TOTAL_AMOUNT AS ReceiptBatch_TOTAL_AMOUNT,\n    MERCHANT AS ReceiptBatch_MERCHANT,\n    LOCATION AS ReceiptBatch_LOCATION,\n    CREDIT_TRANSACTION AS ReceiptBatch_CREDIT\nFROM XX_AP_BATCH_RECEIPTS\nWHERE REPORT_ID = '${REPORT_NUMBER}'\nORDER BY RECEIPT_ID",
