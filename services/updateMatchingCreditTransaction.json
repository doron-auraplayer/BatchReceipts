{
  "name": "updateMatchingCreditTransaction",
  "description": "",
  "formUrl": "${env.DB_CONNECTION_STR}",
  "command": "UPDATE XX_AP_BATCH_RECEIPTS receipt\nSET CREDIT_TRANSACTION = TO_CHAR(${TRANSACTION_ID:NUMERIC})\nWHERE receipt.RECEIPT_ID = ${RECEIPT_ID:NUMERIC}\n  AND receipt.STATUS IN ('PROCESSED', 'READY')\n  AND receipt.REPORT_ID IS NULL\n  AND TRIM(receipt.CREDIT_TRANSACTION) IS NULL\n  AND EXISTS (\n      SELECT 1\n      FROM AP_CREDIT_CARD_TRXNS_ALL trxns\n      JOIN AP_CARDS_ALL cards\n        ON cards.CARD_ID = trxns.CARD_ID\n       AND cards.CARD_PROGRAM_ID = trxns.CARD_PROGRAM_ID\n       AND cards.ORG_ID = trxns.ORG_ID\n      JOIN FND_USER fu ON fu.EMPLOYEE_ID = cards.EMPLOYEE_ID\n      WHERE trxns.TRX_ID = ${TRANSACTION_ID:NUMERIC}\n        AND fu.USER_NAME = receipt.EBS_USER_NAME\n        AND trxns.REPORT_HEADER_ID IS NULL\n        AND NVL(trxns.EXPENSED_AMOUNT, 0) = 0\n        AND TRUNC(trxns.TRANSACTION_DATE) = TRUNC(receipt.RECEIPT_DATE)\n        AND trxns.TRANSACTION_AMOUNT = receipt.TOTAL_AMOUNT\n  )\n  AND NOT EXISTS (\n      SELECT 1\n      FROM XX_AP_BATCH_RECEIPTS linked\n      WHERE linked.EBS_USER_NAME = receipt.EBS_USER_NAME\n        AND LTRIM(TRIM(linked.CREDIT_TRANSACTION), '0') = TO_CHAR(${TRANSACTION_ID:NUMERIC})\n  )\n",
  "isEnabled": true,
