{
  "name": "ReceiptBatch_TransactionByUser",
  "description": "",
  "formUrl": "${env.DB_CONNECTION_STR}",
  "command": "SELECT trxns.TRX_ID AS TRANSACTION_ID,\n       TO_CHAR(trxns.TRANSACTION_DATE, 'YYYY-MM-DD') AS TRANSACTION_RECEIPT_DATE,\n       trxns.TRANSACTION_AMOUNT AS TRANSACTION_AMOUNT,\n       trxns.MERCHANT_NAME1 AS TRANSACTION_MERCHANT,\n       AP_WEB_DB_CCARD_PKG.GetLocation(trxns.MERCHANT_CITY, trxns.MERCHANT_PROVINCE_STATE) AS TRANSACTION_LOCATION,\n       CASE WHEN EXISTS (\n           SELECT 1\n           FROM XX_AP_BATCH_RECEIPTS receipt\n           WHERE receipt.EBS_USER_NAME = fu.USER_NAME\n             AND LTRIM(TRIM(receipt.CREDIT_TRANSACTION), '0') = TO_CHAR(trxns.TRX_ID)\n       ) THEN 'Y' ELSE 'N' END AS TRANSACTION_LINKED,\n       COUNT(*) OVER () AS TRANSACTION_TOTAL_COUNT\nFROM AP_CREDIT_CARD_TRXNS_ALL trxns\nJOIN AP_CARDS_ALL cards\n  ON cards.CARD_ID = trxns.CARD_ID\n AND cards.CARD_PROGRAM_ID = trxns.CARD_PROGRAM_ID\n AND cards.ORG_ID = trxns.ORG_ID\nJOIN FND_USER fu ON fu.EMPLOYEE_ID = cards.EMPLOYEE_ID\nWHERE fu.USER_NAME = UPPER(TRIM(${EBS_USER:VARCHAR}))\n  AND trxns.REPORT_HEADER_ID IS NULL\n  AND NVL(trxns.EXPENSED_AMOUNT, 0) = 0\n  AND trxns.TRANSACTION_DATE IS NOT NULL\n  AND trxns.TRANSACTION_AMOUNT IS NOT NULL\nORDER BY trxns.TRANSACTION_DATE DESC, trxns.TRX_ID DESC\n",
  "isEnabled": true,
