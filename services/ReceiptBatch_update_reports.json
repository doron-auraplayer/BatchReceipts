  "command": "UPDATE XX_AP_BATCH_RECEIPTS\nSET REPORT_ID = '${REPORT_NUMBER}',\n    REPORT_NAME = '${REPORT_PURPOSE}',\n    REPORT_CREATE_DATE = SYSDATE\nWHERE RECEIPT_ID IN (\n    SELECT ids.RECEIPT_ID\n    FROM JSON_TABLE(\n        '${SELECTED_RECEIPT_IDS}',\n        '$[*]' ERROR ON ERROR\n        COLUMNS (\n            RECEIPT_ID NUMBER PATH '$' ERROR ON ERROR\n        )\n    ) ids\n)",
