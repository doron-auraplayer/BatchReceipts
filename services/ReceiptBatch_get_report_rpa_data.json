{
  "name": "ReceiptBatch_get_report_rpa_data",
  "description": "Read-only complete linked receipt/report data for future RPA integration.",
  "formUrl": "${env.DB_CONNECTION_STR}",
  "command": "SELECT\n    r.REPORT_ID AS REPORT_NUMBER,\n    MAX(r.REPORT_NAME) OVER () AS REPORT_PURPOSE,\n    TO_CHAR(MAX(r.REPORT_CREATE_DATE) OVER (), 'YYYY-MM-DD\"T\"HH24:MI:SS') AS REPORT_CREATE_DATE,\n    r.RECEIPT_ID AS RECEIPT_ID,\n    r.STATUS AS STATUS,\n    r.EBS_USER_NAME AS EBS_USER_NAME,\n    r.FILE_NAME AS FILE_NAME,\n    r.FILE_TYPE AS FILE_TYPE,\n    r.EXPENSE_TYPE AS EXPENSE_TYPE,\n    r.TOTAL_AMOUNT AS TOTAL_AMOUNT,\n    TO_CHAR(r.RECEIPT_DATE, 'YYYY-MM-DD') AS RECEIPT_DATE,\n    r.MERCHANT AS MERCHANT,\n    r.LOCATION AS LOCATION,\n    r.DEPARTMENT AS DEPARTMENT,\n    r.CREDIT_TRANSACTION AS CREDIT_TRANSACTION,\n    r.EXPENSE_DATA_JSON AS EXPENSE_DATA_JSON,\n    DBMS_LOB.GETLENGTH(r.EXPENSE_DATA_JSON) AS EXPENSE_DATA_JSON_LENGTH,\n    TO_CHAR(r.EXPENSE_DATA_UPDATED_DATE, 'YYYY-MM-DD\"T\"HH24:MI:SS.FF6') AS EXPENSE_DATA_UPDATED_DATE,\n    r.TEMPLATE_NAME AS TEMPLATE_NAME,\n    r.PAYMENT_TYPE AS PAYMENT_TYPE,\n    r.LINE_NUM AS LINE_NUM,\n    r.ERROR_MESSAGE AS ERROR_MESSAGE,\n    COUNT(*) OVER () AS TOTAL_RECEIPTS\nFROM XX_AP_BATCH_RECEIPTS r\nWHERE r.REPORT_ID = '${REPORT_NUMBER}'\nORDER BY r.RECEIPT_ID\n",
